{
  "components": {
    "schemas": {
      "ApiProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Problem type identifier."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Short human-readable error summary."
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "instance": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "additionalProperties": false,
        "description": "RFC 7807-style API problem details payload."
      },
      "DocumentReference": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string",
            "minLength": 1,
            "description": "Canonical document hash."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Display title for the document."
          },
          "documentType": {
            "type": "string",
            "minLength": 1,
            "description": "Normalized document type."
          },
          "documentDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO 8601 calendar date.",
            "nullable": true
          }
        },
        "required": [
          "hash",
          "title",
          "documentType"
        ],
        "additionalProperties": false,
        "description": "Reference to a canonical source document."
      },
      "MoneyAmount": {
        "type": "object",
        "properties": {
          "amountMinor": {
            "type": "integer",
            "description": "Integer amount in grosz or other currency minor unit."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "Three-letter ISO currency code."
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ],
        "additionalProperties": false,
        "description": "Monetary amount stored as minor units."
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
