  "info": {
    "description": "REST transport contracts for the private Property Vault application.",
    "title": "Property Vault API",
    "version": "0.1.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.0",
  "paths": {
    "/api/dashboard/month-breakdown": {
      "get": {
        "operationId": "getDashboardMonthBreakdown",
        "responses": {
          "200": {
            "description": "Dashboard month summary and normalized category breakdown.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardMonthBreakdownResponse"
                }
              }
            }
          },
          "404": {
            "description": "Requested dashboard month was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        },
        "summary": "Get dashboard month summary and category breakdown.",
        "tags": [
          "dashboard"
        ],
        "parameters": [
          {
            "description": "Reporting month in YYYY-MM format.",
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "description": "Reporting month in YYYY-MM format."
            }
          }
        ]
      }
    },
    "/api/documents/{hash}": {
      "get": {
        "operationId": "getDocumentDetail",
        "responses": {
          "200": {
            "description": "Document detail with provenance and extracted evidence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Requested document was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        },
        "summary": "Get document detail with provenance.",
        "tags": [
          "documents"
        ],
        "parameters": [
          {
            "description": "Canonical SHA-256 document hash.",
            "in": "path",
            "name": "hash",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Canonical SHA-256 document hash."
            }
          }
        ]
      }
    },
    "/api/documents": {
      "get": {
        "operationId": "getDocuments",
        "responses": {
          "200": {
            "description": "Document catalog with optional type filtering.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentCatalogResponse"
                }
              }
            }
          }
        },
        "summary": "Get the indexed document catalog.",
        "tags": [
          "documents"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "documentType",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/api": {
      "get": {
        "operationId": "getApiIndex",
        "responses": {
          "200": {
            "description": "API metadata and discovery links.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiIndexResponse"
                }
              }
            }
          }
        },
        "summary": "Get API entry metadata.",
        "tags": [
          "system"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getApiHealth",
        "responses": {
          "200": {
            "description": "Current API health status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckResponse"
                }
              }
            }
          },
          "503": {
            "description": "One or more core dependencies are unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiProblem"
                }
              }
            }
          }
        },
        "summary": "Get API health status.",
        "tags": [
          "system"
        ]
      }
    }
  }
}
