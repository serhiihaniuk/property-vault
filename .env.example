# Local Docker + web app defaults for development only.
POSTGRES_DB=dabrowskiego
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Shared app/package connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dabrowskiego

# Better Auth package defaults for local development.
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
