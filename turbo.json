{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "package-lock.json",
    "turbo.json",
    "eslint.config.mjs",
    "tsconfig.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["typecheck", "^typecheck"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["typecheck", "^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "AUTH_SECRET",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXT_PUBLIC_APP_ORIGIN",
        "NEXT_PUBLIC_AUTH_BASE_URL",
        "PORT",
        "PROPERTY_VAULT_SKIP_WEB_PREDEV"
      ]
    }
  }
}
