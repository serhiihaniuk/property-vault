{
  "name": "dabrowskiego",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@dabrowskiego/web",
    "build": "npm run --workspace @dabrowskiego/contracts build && npm run --workspace @dabrowskiego/application build && npm run --workspace @dabrowskiego/sync build && turbo build --filter=@dabrowskiego/web",
    "lint": "turbo lint --filter=@dabrowskiego/web",
    "db:generate": "npm run --workspace @dabrowskiego/db db:generate",
    "db:migrate": "npm run --workspace @dabrowskiego/db db:migrate",
    "docker:db:up": "docker compose up -d postgres",
    "docker:db:down": "docker compose down",
    "docker:db:reset": "docker compose down -v",
    "docker:db:logs": "docker compose logs -f postgres",
    "setup": "node --experimental-strip-types tools/cli.ts setup",
    "auth": "node --experimental-strip-types tools/gmail-auth.ts",
    "vault": "node --experimental-strip-types tools/cli.ts",
    "gmail": "node --experimental-strip-types tools/gmail-cli.ts",
    "reindex": "node --experimental-strip-types tools/cli.ts reindex",
    "validate": "node --experimental-strip-types tools/cli.ts validate",
    "typecheck": "npm run typecheck:vault && npm run typecheck:db && npm run typecheck:auth && npm run typecheck:contracts && npm run typecheck:application && npm run typecheck:sync && turbo typecheck --filter=@dabrowskiego/web",
    "typecheck:application": "npm run --workspace @dabrowskiego/application typecheck",
    "typecheck:auth": "npm run --workspace @dabrowskiego/auth typecheck",
    "typecheck:contracts": "npm run --workspace @dabrowskiego/contracts typecheck",
    "typecheck:db": "npm run --workspace @dabrowskiego/db typecheck",
    "typecheck:sync": "npm run --workspace @dabrowskiego/sync typecheck",
    "typecheck:vault": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tools/**/*.test.ts",
    "test:contracts": "npm run --workspace @dabrowskiego/contracts test"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "consola": "^3",
    "date-fns": "^4",
    "file-type": "^22.0.1",
    "google-auth-library": "^9",
    "googleapis": "^144",
    "open": "^10",
    "pdf-parse": "^2",
    "pino": "^9",
    "proper-lockfile": "^4",
    "write-file-atomic": "^5",
    "zod": "^3",
    "zod-to-json-schema": "^3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7",
    "@types/node": "^22",
    "@types/proper-lockfile": "^4",
    "@types/write-file-atomic": "^4",
    "turbo": "^2.6.3",
    "typescript": "^6.0.3"
  }
}
