{
  "name": "dabrowskiego",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types tools/dev.ts",
    "build": "npm run openapi:check && turbo run build --filter=@dabrowskiego/web",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "lint": "turbo run lint",
    "db:generate": "npm run --workspace @dabrowskiego/db db:generate",
    "db:migrate": "npm run --workspace @dabrowskiego/db db:migrate",
    "docker:db:up": "docker compose up -d --wait postgres",
    "docker:db:down": "docker compose down",
    "docker:db:reset": "docker compose down -v",
    "docker:db:logs": "docker compose logs -f postgres",
    "setup": "node --experimental-strip-types tools/cli.ts setup",
    "auth": "node --experimental-strip-types tools/gmail-auth.ts",
    "vault": "node --experimental-strip-types tools/cli.ts",
    "gmail": "node --experimental-strip-types tools/gmail-cli.ts",
    "reindex": "node --experimental-strip-types tools/cli.ts reindex",
    "validate": "node --experimental-strip-types tools/cli.ts validate",
    "openapi:check": "npm run --workspace @dabrowskiego/contracts openapi:check",
    "typecheck": "npm run typecheck:tools && npm run typecheck:workspace",
    "typecheck:tools": "tsc --noEmit",
    "typecheck:workspace": "turbo run typecheck",
    "test": "npm run test:workspace && npm run test:tools",
    "test:tools": "node --test --experimental-strip-types tools/**/*.test.ts",
    "test:workspace": "turbo run test",
    "test:contracts": "npm run --workspace @dabrowskiego/contracts test"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "consola": "^3",
    "date-fns": "^4",
    "file-type": "^22.0.1",
    "google-auth-library": "^9",
    "googleapis": "^144",
    "open": "^10",
    "pdf-parse": "^2",
    "pino": "^9",
    "proper-lockfile": "^4",
    "write-file-atomic": "^5",
    "zod": "^3",
    "zod-to-json-schema": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7",
    "@types/node": "^22",
    "@types/proper-lockfile": "^4",
    "@types/write-file-atomic": "^4",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "turbo": "^2.6.3",
    "typescript-eslint": "^8.46.3",
    "typescript": "^6.0.3"
  }
}
